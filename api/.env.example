# Copy to .env and fill in. The api won't start without the first three.

# bcrypt hash of the login password. Generate one with:
#   node -e "require('bcrypt').hash(process.argv[1], 10).then(console.log)" 'your-password'
AUTH_PASSWORD_HASH=
# Signs login tokens. Use a long random value, and a different one per
# environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Pantry database (libSQL/Turso), e.g. file:../pantry.db locally.
PANTRY_DB_URL=
PANTRY_DB_AUTH_TOKEN=

# Where the Mastra agent server runs.
MASTRA_SERVER_URL=http://localhost:4111
# The web app's origin, allowed by CORS.
WEB_ORIGIN=http://localhost:3001
PORT=3000
