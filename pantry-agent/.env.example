# Copy to .env and fill in. Missing values are listed at startup.

# Model and web search providers
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Pinterest app credentials, used on every access-token refresh.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Seeds the token chain. Generate it once with `npm run auth:pinterest`;
# after that, rotated tokens are kept in the cache database.
PINTEREST_REFRESH_TOKEN=
# Only used by the auth-flow script. Must match a redirect URI registered on
# the Pinterest app. Defaults to http://localhost:3000/callback.
PINTEREST_REDIRECT_URI=

# Pinterest cache and token store (libSQL/Turso). Leave the URL unset to use
# a local file: PINTEREST_CACHE_DB_PATH, or pinterest-cache.db by default.
PINTEREST_CACHE_DB_URL=
PINTEREST_CACHE_DB_AUTH_TOKEN=
PINTEREST_CACHE_DB_PATH=

# The api's pantry database, read for grocery lists. Required for grocery
# lists; e.g. file:../pantry.db locally.
PANTRY_DB_URL=
PANTRY_DB_AUTH_TOKEN=

# Mastra's own storage. Leave unset to use a local file (mastra.db).
MASTRA_DB_URL=
MASTRA_DB_AUTH_TOKEN=
